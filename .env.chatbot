# Chatbot service
CHATBOT_PORT=8100
CHATBOT_ENV=development

# MySQL read-only source for ingestion (update to your local credentials)
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=restaurant_system
MYSQL_USER=restaurant_team
MYSQL_PASSWORD=TeamPass123!

# Vector store
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=restaurant_knowledge

# Ingestion behavior
EMBEDDING_MODEL=all-MiniLM-L6-v2
INGEST_RECREATE_COLLECTION=false
INGEST_SQL=SELECT restaurant_id AS id, name, 0 AS price, budget_range AS category, CONCAT(COALESCE(description,''), ' Address: ', COALESCE(address,''), '. Phone: ', COALESCE(phone,''), '. Approval: ', COALESCE(approval_status,'')) AS description FROM restaurants WHERE is_approved = true AND is_active = true

# LLM provider (set your key before using generation)
OPENAI_API_KEY=sk-proj-
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514


DEEPSEEK_API_KEY=sk-9492b1370c534847956fe4a7a7098c98
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
